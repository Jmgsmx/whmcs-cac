{
  "name": "jmgs/whmcs-state-cli",
  "description": "WHMCS Configuration-as-Code CLI skeleton",
  "require": {
    "php": ">=8.1",
    "symfony/yaml": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": { 
      "Whmcs\\": "src/",
      "Whmcs\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
