#!/usr/bin/env php
<?php
$autoload = __DIR__ . '/../vendor/autoload.php';
if (file_exists($autoload)) {
    require $autoload;
}

require __DIR__ . '/../src/Command/ValidateCommand.php';
require __DIR__ . '/../src/Command/ExportLiveCommand.php';
require __DIR__ . '/../src/Command/DiffCommand.php';
require __DIR__ . '/../src/Command/ApplyCommand.php';
require __DIR__ . '/../src/Command/DoctorCommand.php';
require __DIR__ . '/../src/Command/RollbackCommand.php';
require __DIR__ . '/../src/Adapter/AdapterInterface.php';
require __DIR__ . '/../src/Adapter/Result.php';
require __DIR__ . '/../src/Adapter/SettingsAdapter.php';
require __DIR__ . '/../src/Adapter/GatewayAdapter.php';

use Whmcs\Command\ValidateCommand;
use Whmcs\Command\ExportLiveCommand;
use Whmcs\Command\DiffCommand;
use Whmcs\Command\ApplyCommand;
use Whmcs\Command\DoctorCommand;
use Whmcs\Command\RollbackCommand;

$argv = $_SERVER['argv'];
$argc = $_SERVER['argc'];

if ($argc < 2) {
    echo "Usage: php cli/bin/whmcs-state <command> [options]\n";
    echo "Commands:\n";
    echo "  validate --env=<path>              Validate YAML state\n";
    echo "  export-live --env=<path>           Export live state from WHMCS\n";
    echo "  diff --env=<path>                  Compare desired vs live state\n";
    echo "  apply --env=<path> [--force]       Apply desired state (requires --force for non-dev)\n";
    echo "  doctor --whmcs-root=<path>         Run health checks\n";
    echo "  rollback --env=<env>               Rollback to previous backup\n";
    echo "\nOptions:\n";
    echo "  --env=<path>                       Path to state environment (default: state/envs/dev)\n";
    echo "  --whmcs-root=<path>                WHMCS installation root (default: /opt/whmcs)\n";
    echo "  --resource=<type>                  Resource type: all|settings|gateways (default: all)\n";
    echo "  --force                            Required for staging/prod apply\n";
    echo "  --dry-run                          Show changes without applying\n";
    echo "  --environment=<env>                Environment: dev|staging|prod (default: dev)\n";
    echo "  --from-manifest=<file>             Rollback to state in manifest (optional)\n";
    exit(1);
}

$command = $argv[1];
$envPath = 'state/envs/dev';
$resource = 'all';
$whmcsRoot = getenv('WHMCS_ROOT') ?: '/opt/whmcs';
$force = false;
$dryRun = false;
$environment = 'dev';
$fromManifest = null;

foreach ($argv as $arg) {
    if (str_starts_with($arg, '--env=')) {
        $envPath = substr($arg, 6);
    }
    if (str_starts_with($arg, '--resource=')) {
        $resource = substr($arg, 11);
    }
    if (str_starts_with($arg, '--whmcs-root=')) {
        $whmcsRoot = substr($arg, 13);
    }
    if (str_starts_with($arg, '--environment=')) {
        $environment = substr($arg, 14);
    }
    if (str_starts_with($arg, '--from-manifest=')) {
        $fromManifest = substr($arg, 15);
    }
    if ($arg === '--force') {
        $force = true;
    }
    if ($arg === '--dry-run') {
        $dryRun = true;
    }
}

if ($command === 'validate') {
    $exit = ValidateCommand::run($envPath);
    exit($exit);
}

if ($command === 'export-live') {
    $exit = ExportLiveCommand::run($whmcsRoot, $resource);
    exit($exit);
}

if ($command === 'diff') {
    $exit = DiffCommand::run($envPath, $whmcsRoot, $resource);
    exit($exit);
}

if ($command === 'apply') {
    $exit = ApplyCommand::run($envPath, $whmcsRoot, $force, $dryRun, $environment);
    exit($exit);
}

if ($command === 'doctor') {
    $exit = DoctorCommand::run($whmcsRoot);
    exit($exit);
}

if ($command === 'rollback') {
    $exit = RollbackCommand::run($environment, $whmcsRoot, $fromManifest);
    exit($exit);
}

echo "Unknown command: {$command}\n";
exit(2);
